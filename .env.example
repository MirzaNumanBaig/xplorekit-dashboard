# Copy to .env for local runs. In GitHub, these are Actions secrets/variables (Settings -> Secrets and variables -> Actions).
# Never commit real values.

# --- how the agents talk to Claude (set ONE) ---
CLAUDE_CODE_OAUTH_TOKEN=     # the Claude Code token (also needs the `claude` CLI: npm i -g @anthropic-ai/claude-code). The workflow installs it.
CLAUDE_CODE_OAUTH_TOKEN_2=   # optional fallbacks, tried in order when the first token fails or is out of usage
CLAUDE_CODE_OAUTH_TOKEN_3=
ANTHROPIC_API_KEY=           # alternative: a normal API key (takes priority if both are set)
XK_LLM=                      # optional force: claude_cli | anthropic | none
XK_MODEL=                    # optional override of llm.model in xplorekit/config/settings.json

# --- hand-off to the private site repo (Actions secret) ---
SITE_REPO_TOKEN=             # fine-grained token, ONLY the site repo: Contents read/write + Pull requests read/write

# --- optional sources; each source is skipped when its key is missing ---
GITHUB_TOKEN=                # Actions provides one automatically; locally it only raises the GitHub API rate limit
REDDIT_CLIENT_ID=            # official Reddit API only (reddit.com's robots.txt forbids crawling)
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=             # YouTube Data API v3

# --- politeness ---
XK_CONTACT=                  # optional: a URL or email added to our User-Agent so site owners can reach you (Actions variable)
