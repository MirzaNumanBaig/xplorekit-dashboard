{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$"
      },
      "minItems": 1
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale"
      ]
    },
    "quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "prompt": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chatgpt",
          "claude",
          "gemini"
        ]
      },
      "minItems": 1
    },
    "use_case": {
      "type": "string",
      "enum": [
        "marketing",
        "coding",
        "study",
        "business",
        "content",
        "freelancing",
        "research",
        "productivity",
        "other"
      ]
    },
    "example_output_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": [
    "id",
    "section",
    "source_url",
    "source_urls",
    "first_seen",
    "last_checked",
    "status",
    "quality_score",
    "verified",
    "title",
    "prompt",
    "models",
    "use_case",
    "example_output_summary",
    "tags"
  ],
  "additionalProperties": false
}
