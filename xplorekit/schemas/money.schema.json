{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Make money with AI idea",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$"
      },
      "minItems": 1
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale"
      ]
    },
    "quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "workflow_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 12
    },
    "tools_and_prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 10
    },
    "income": {
      "type": "object",
      "properties": {
        "stated_in_source": {
          "type": "boolean"
        },
        "low": {
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "enum": [
            "hour",
            "project",
            "month",
            "none"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 15,
          "maxLength": 400
        }
      },
      "required": [
        "stated_in_source",
        "low",
        "high",
        "currency",
        "period",
        "basis"
      ],
      "additionalProperties": false
    },
    "time_to_first_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 8
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chatgpt",
          "claude",
          "gemini"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "section",
    "source_url",
    "source_urls",
    "first_seen",
    "last_checked",
    "status",
    "quality_score",
    "verified",
    "title",
    "audience",
    "summary",
    "workflow_steps",
    "tools_and_prompts",
    "income",
    "time_to_first_result",
    "difficulty",
    "risks",
    "models"
  ],
  "additionalProperties": false
}
