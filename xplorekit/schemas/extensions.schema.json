{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chrome extension",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$"
      },
      "minItems": 1
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale"
      ]
    },
    "quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "pros": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 6
    },
    "cons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 6
    },
    "pricing": {
      "type": "string",
      "enum": [
        "free",
        "freemium",
        "paid",
        "unknown"
      ]
    },
    "pricing_note": {
      "type": "string"
    },
    "ai_related": {
      "type": "boolean"
    },
    "store_url": {
      "type": "string",
      "pattern": "^https://chromewebstore\\.google\\.com/detail/[^\\s]+$"
    },
    "extension_last_updated": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|unknown)$"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 6
    }
  },
  "required": [
    "id",
    "section",
    "source_url",
    "source_urls",
    "first_seen",
    "last_checked",
    "status",
    "quality_score",
    "verified",
    "name",
    "summary",
    "audience",
    "pros",
    "cons",
    "pricing",
    "ai_related",
    "store_url",
    "extension_last_updated",
    "alternatives"
  ],
  "additionalProperties": false
}
