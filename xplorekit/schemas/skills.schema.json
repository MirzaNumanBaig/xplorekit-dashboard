{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude skill",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$"
      },
      "minItems": 1
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale"
      ]
    },
    "quality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "install_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 8
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "example_use_case": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400
    },
    "skill_type": {
      "type": "string",
      "enum": [
        "claude-skill",
        "agent-skill",
        "collection"
      ]
    }
  },
  "required": [
    "id",
    "section",
    "source_url",
    "source_urls",
    "first_seen",
    "last_checked",
    "status",
    "quality_score",
    "verified",
    "name",
    "summary",
    "install_steps",
    "repo_url",
    "example_use_case",
    "skill_type"
  ],
  "additionalProperties": false
}
